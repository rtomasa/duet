{
  "app-id": "io.github.rtomasa.Briefcase",
  "runtime": "org.gnome.Platform",
  "runtime-version": "48",
  "sdk": "org.gnome.Sdk",
  "command": "gnome-briefcase",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri"
  ],
  "modules": [
    {
      "name": "gnome-briefcase",
      "buildsystem": "meson",
      "sources": [
        { "type": "dir", "path": ".." }
      ]
    }
  ]
}

