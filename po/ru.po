#: src/application.rs:1144
msgid "The destination folder already exists and is not empty: {path}"
msgstr "Папка назначения уже существует и не пуста: {path}"

#: src/application.rs:1148
msgid "The Source and Briefcase folders cannot contain one another"
msgstr "Папки источника и портфеля не могут содержать друг друга"

#: src/application.rs:1151
msgid "The path “{path}” does not remain inside the synchronized folder"
msgstr "Путь «{path}» выходит за пределы синхронизируемой папки"

#: src/application.rs:1155
msgid "Symbolic links are not supported yet: {path}"
msgstr "Символические ссылки пока не поддерживаются: {path}"

#: src/application.rs:1159
msgid "Another synchronization is modifying this Briefcase"
msgstr "Другая синхронизация изменяет этот портфель"

#: src/application.rs:1161
msgid "Synchronization was stopped"
msgstr "Синхронизация была остановлена"

#: src/application.rs:1163
msgid "The Source is unavailable: {path}"
msgstr "Источник недоступен: {path}"

#: src/application.rs:1166
msgid "Unresolved conflict: {path}"
msgstr "Неразрешённый конфликт: {path}"

#: src/application.rs:1169
msgid "Database error: {error}"
msgstr "Ошибка базы данных: {error}"

#: src/application.rs:1171
msgid "Invalid Briefcase metadata: {error}"
msgstr "Недопустимые метаданные портфеля: {error}"

