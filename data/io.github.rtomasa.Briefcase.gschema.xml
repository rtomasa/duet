<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="io.github.rtomasa.Briefcase" path="/io/github/rtomasa/Briefcase/">
    <key name="known-briefcases" type="as">
      <default>[]</default>
      <summary>Known Briefcase folders</summary>
    </key>
    <key name="deletion-action" type="s">
      <choices>
        <choice value="ask"/>
        <choice value="skip"/>
        <choice value="restore"/>
        <choice value="delete"/>
      </choices>
      <default>'ask'</default>
      <summary>Default action when a file was deleted</summary>
    </key>
    <key name="change-detection-mode" type="s">
      <choices><choice value="fast"/><choice value="verified"/></choices>
      <default>'fast'</default>
      <summary>Change detection mode</summary>
    </key>
    <key name="window-width" type="i"><default>720</default></key>
    <key name="window-height" type="i"><default>620</default></key>
  </schema>
</schemalist>
