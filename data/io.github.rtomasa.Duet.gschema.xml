<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="io.github.rtomasa.Duet" path="/io/github/rtomasa/Duet/">
    <key name="known-targets" type="as">
      <default>[]</default>
      <summary>Known Target folders</summary>
    </key>
    <key name="deletion-action" type="s">
      <choices>
        <choice value="ask"/>
        <choice value="skip"/>
        <choice value="restore"/>
        <choice value="delete"/>
      </choices>
      <default>'ask'</default>
      <summary>Default action when a file was deleted</summary>
    </key>
    <key name="target-only-action" type="s">
      <choices>
        <choice value="ask"/>
        <choice value="skip"/>
        <choice value="copy"/>
        <choice value="delete"/>
      </choices>
      <default>'ask'</default>
      <summary>Default action when a file exists only in Target</summary>
    </key>
    <key name="skip-hidden-files" type="b">
      <default>false</default>
      <summary>Skip hidden files</summary>
      <description>Ignore files and folders whose names begin with a period when comparing folders</description>
    </key>
    <key name="copy-symbolic-links" type="b">
      <default>true</default>
      <summary>Copy symbolic links</summary>
      <description>Copy symbolic links as links instead of skipping them when comparing folders</description>
    </key>
    <key name="window-width" type="i"><default>720</default></key>
    <key name="window-height" type="i"><default>620</default></key>
  </schema>
</schemalist>
